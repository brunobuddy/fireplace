# ── Backend ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Database — local dev uses the discrete DB_* vars (docker-compose Postgres).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fireplace
DB_PASSWORD=fireplace
DB_NAME=fireplace

# Managed Postgres (Railway/etc.) — if set, DATABASE_URL wins over DB_*.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# DB_SSL=true                 # force TLS (auto-on when url has sslmode=require)
# DB_SYNCHRONIZE=true         # create/update schema from entities.
#                             # Defaults: on unless NODE_ENV=production.
#                             # No migrations yet → set true on first deploy.

# The app is single-origin — NestJS serves the SPA + API on one port — so no
# CORS or API-URL configuration is needed.

# ── Auth ───────────────────────────────────────────────────────────────
# App login users that gate the whole app. Format: comma-separated
# `email:secret` pairs. The secret may be a plaintext password OR a bcrypt
# hash ($2…) — auto-detected. Generate a hash:
#   npm run auth:hash --workspace=backend -- 'your-password'
# (Plaintext passwords must not contain ':' or ',' — use a hash if needed.)
# If unset outside production, an insecure dev login (demo@fireplace.app /
# demo) is used so `npm run dev` works with no setup.
AUTH_USERS=alex@fireplace.app:change-me-1,sam@fireplace.app:change-me-2

# Secret used to sign login tokens (JWT). MUST be long & random in prod —
# the app refuses to boot in production without it.
JWT_SECRET=replace-with-a-long-random-string
# Token lifetime: e.g. 7d, 24h, 30m.
JWT_EXPIRES_IN=7d

# ── Spark (daily bonding question) ─────────────────────────────────────────
# Questions are generated with the OpenAI SDK. A key is REQUIRED to generate
# (the "✨ New question" button and the daily cron) — there is no static
# fallback; a missing key fails closed. The app still boots and shows the
# seeded question without one. Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Model used for generation (any Chat Completions model). Default: gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# ── Dev only ─────────────────────────────────────────────────────────────
# Vite proxies /api + /socket.io to the backend; override the target port if
# the backend isn't on 3000 (`/serve` sets this for you).
# VITE_BACKEND_PORT=3000

# ── docker-compose host ports (override to avoid collisions) ───────────
# POSTGRES_HOST_PORT=5432
# APP_HOST_PORT=3000
