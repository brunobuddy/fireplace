# ── Backend ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Database — local dev uses the discrete DB_* vars (docker-compose Postgres).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fireplace
DB_PASSWORD=fireplace
DB_NAME=fireplace

# Managed Postgres (Railway/etc.) — if set, DATABASE_URL wins over DB_*.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# DB_SSL=true                 # force TLS (auto-on when url has sslmode=require).
#                             # Leave UNSET for Railway's private DATABASE_URL
#                             # (no TLS there); set only for a public URL.
# DB_SYNCHRONIZE=true         # create/update schema from entities.
#                             # Defaults: on unless NODE_ENV=production.
#                             # No migrations yet → set true on first deploy.

# The app is single-origin — NestJS serves the SPA + API on one port — so no
# CORS or API-URL configuration is needed.

# ── Auth ───────────────────────────────────────────────────────────────
# The two household logins. Format: comma-separated `email:secret` pairs; the
# secret is an UNLOCK PATTERN — the cells of the 3x3 grid it walks, in order —
# as plaintext or (preferably) a bcrypt hash ($2…), auto-detected. Cells are
# numbered row-major:
#
#     0 1 2
#     3 4 5
#     6 7 8
#
# so the "U" 0→3→6→7→8→5→2 is the string `0367852`. Six cells minimum.
# CONVENTION (matters): the FIRST entry is Bruno, the SECOND is Audrey —
# the seeder maps them in this order onto the two hardcoded members on every
# boot, so rotating an email here propagates to the DB without a wipe.
# Hash one (it canonicalizes the walk exactly as the phone does):
#   npm run auth:hash-pattern --workspace=backend -- 0-3-6-7-8-5-2
# If unset outside production, insecure dev logins (bruno@fireplace.local and
# audrey@fireplace.local, pattern 0367852) let `npm run dev` work with no setup.
AUTH_USERS=you@example.com:0367852,partner@example.com:0367852

# Secret used to sign login tokens (JWT). MUST be long & random in prod —
# the app refuses to boot in production without it.
JWT_SECRET=replace-with-a-long-random-string
# Token lifetime: e.g. 7d, 24h, 30m.
JWT_EXPIRES_IN=7d

# ── Login throttling ───────────────────────────────────────────────────
# A pattern is only ~18.5 bits (380,336 walks of six cells or more), so bounding
# attempts — not the grid — is what keeps it out of reach. Buckets are keyed per
# (client IP, email). Defaults shown; all optional.
# LOGIN_MAX_ATTEMPTS=5          # tries per window before the lockout bites
# LOGIN_WINDOW_MS=60000         # length of that window, in ms
# LOGIN_BLOCK_MS=900000         # how long a tripped bucket stays locked
# LOGIN_DAILY_MAX_ATTEMPTS=20   # hard ceiling per 24h
# In production the app trusts exactly one proxy hop, so the client IP is real.
# Storage is in-memory: the limits are per app instance.

# ── Manifest (LLM router) ────────────────────────────────────────────────
# Used by TWO features:
#   • Spark — daily bonding question. Tagged `fireplace.spark.generate`
#     (no tag header today; coming). Without a key, the app boots and shows
#     the seeded question; the "✨ New question" button + daily cron fail
#     closed.
#   • Groceries — auto-categorizes new items. Every request carries
#     `X-Manifest-Tag: fireplace.groceries.categorize` (and the same string
#     in the OpenAI `user` field). Set up a routing rule in
#     app.manifest.build that pins this tag to a small/cheap model — the
#     prompt is short and the task is trivial classification. Without a
#     key, categorization is silently disabled (items land in Uncategorized;
#     users re-bucket by tap or drag).
# Get a key: https://app.manifest.build
MANIFEST_API_KEY=mnfst_...
# Override the API base URL — e.g. for a self-hosted Manifest instance
# (default: https://app.manifest.build/v1; self-hosted default: http://127.0.0.1:2099/v1).
# MANIFEST_BASE_URL=https://app.manifest.build/v1

# ── Dev only ─────────────────────────────────────────────────────────────
# Vite proxies /api + /socket.io to the backend; override the target port if
# the backend isn't on 3000 (`/serve` sets this for you).
# VITE_BACKEND_PORT=3000

# ── docker-compose host ports (override to avoid collisions) ───────────
# POSTGRES_HOST_PORT=5432
# APP_HOST_PORT=3000
