# ── Backend ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Database — local dev uses the discrete DB_* vars (docker-compose Postgres).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fireplace
DB_PASSWORD=fireplace
DB_NAME=fireplace

# Managed Postgres (Railway/etc.) — if set, DATABASE_URL wins over DB_*.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# DB_SSL=true                 # force TLS (auto-on when url has sslmode=require)
# DB_SYNCHRONIZE=true         # create/update schema from entities.
#                             # Defaults: on unless NODE_ENV=production.
#                             # No migrations yet → set true on first deploy.

# CORS — comma separated list of origins allowed for the SPA + websockets
CORS_ORIGINS=http://localhost:5173

# ── Frontend ───────────────────────────────────────────────────────────
# Local dev (Vite, build-time). In Docker/Railway this is irrelevant — the
# image reads API_URL at container start and writes /env.js.
VITE_API_URL=http://localhost:3000

# ── docker-compose host ports (override to avoid collisions) ───────────
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=3000
# WEB_HOST_PORT=8080
