# envsubst'd by the nginx entrypoint — only real env vars (e.g. ${PORT})
# are substituted; nginx variables like $uri are left intact.
server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    gzip            on;
    gzip_min_length 1024;
    gzip_types      text/css application/javascript application/json application/manifest+json image/svg+xml;

    # The shell and runtime config must never be cached.
    location = /index.html { add_header Cache-Control "no-store"; }
    location = /env.js     { add_header Cache-Control "no-store"; }

    # The service worker must update promptly — never cache it.
    location = /sw.js      { add_header Cache-Control "no-cache"; }

    # The web app manifest needs the right MIME type to install cleanly.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header   Cache-Control "no-cache";
    }

    # Content-hashed build assets — cache hard.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA history fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
